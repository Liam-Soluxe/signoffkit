{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Liam-Soluxe/signoffkit/blob/main/config/schema.json",
  "title": "SignoffKit pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "id", "template", "projectName", "clientLabel", "version", "reviewer", "reviewDate", "createdAt", "updatedAt", "checks"],
  "properties": {
    "format": { "const": "signoffkit-pack" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "template": { "enum": ["website", "campaign", "creative", "scope"] },
    "projectName": { "type": "string" },
    "clientLabel": { "type": "string" },
    "version": { "type": "string" },
    "reviewer": { "type": "string" },
    "reviewDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "description", "status", "notes", "evidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "status": { "enum": ["pending", "pass", "flag", "na"] },
          "notes": { "type": "string" },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name", "type", "size", "sha256", "dataUrl", "attachedAt"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "name": { "type": "string" },
                "type": { "type": "string" },
                "size": { "type": "integer", "minimum": 0, "maximum": 5242880 },
                "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
                "dataUrl": { "type": "string" },
                "attachedAt": { "type": "string", "format": "date-time" },
                "integrity": { "enum": ["computed", "unverified"] }
              }
            }
          }
        }
      }
    }
  }
}
